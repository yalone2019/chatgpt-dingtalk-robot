# Hermes Agent local profile (~/.hermes/.env)
# Copy values you need into ~/.hermes/.env — never commit real secrets.

# --- Model: DeepSeek ---
DEEPSEEK_API_KEY=sk-your-deepseek-key

# --- DingTalk Stream Mode (recommended local chat path) ---
# Client ID = AppKey, Client Secret = AppSecret
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
# Required: only listed DingTalk user IDs can talk to the bot
DINGTALK_ALLOWED_USERS=
# DINGTALK_REQUIRE_MENTION=true

# --- OpenAI-compatible API so this Node robot can call local Hermes ---
API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
API_SERVER_KEY=change-me-local-dev
API_SERVER_MODEL_NAME=hermes-agent
